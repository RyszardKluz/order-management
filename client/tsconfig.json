{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "types": ["jest", "node"],

  },
  "include": ["**/*.ts", "**/*.tsx","src","jest.setup.ts"],
  "exclude": ["node_modules"]
}
